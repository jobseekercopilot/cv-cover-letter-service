<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jobseekercopilot.clients</groupId>
    <artifactId>cv-cover-letter-service-client</artifactId>
    <version>3.1.0-rev.f2c5916fa0da</version>
    <packaging>jar</packaging>

    <name>Job Seeker Copilot CV and Cover Letter API Client</name>
    <description>Producer-owned generated Java client for the CV and Cover Letter API.</description>
    <url>https://github.com/jobseekercopilot/cv-cover-letter-service</url>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-07-24T00:00:00Z</project.build.outputTimestamp>
        <openapi-generator.version>7.5.0</openapi-generator.version>
        <spring-framework.version>6.1.1</spring-framework.version>
        <jackson.version>2.15.3</jackson.version>
        <jackson-databind-nullable.version>0.2.10</jackson-databind-nullable.version>
        <jakarta-annotation.version>2.1.1</jakarta-annotation.version>
        <jakarta-validation.version>3.0.2</jakarta-validation.version>
        <jobseekercopilot.contract.repository>jobseekercopilot/cv-cover-letter-service</jobseekercopilot.contract.repository>
        <jobseekercopilot.contract.path>contracts/openapi.json</jobseekercopilot.contract.path>
        <jobseekercopilot.contract.version>3.1.0</jobseekercopilot.contract.version>
        <jobseekercopilot.contract.revision>f2c5916fa0da66bb11690439c34c104147508f41</jobseekercopilot.contract.revision>
        <jobseekercopilot.contract.sha256>811cba22ff50bc1b8e89e7cab8d29fdaa56f440ea81fd9fa0e9a0806f2bbe0c3</jobseekercopilot.contract.sha256>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta-annotation.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>${jakarta-validation.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-cv-cover-letter-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../../contracts/openapi.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <generatorName>java</generatorName>
                            <library>resttemplate</library>
                            <apiPackage>com.jobseekercopilot.generated.cvcoverletterservice.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.cvcoverletterservice.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.cvcoverletterservice.client</invokerPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <skipValidateSpec>false</skipValidateSpec>
                            <configOptions>
                                <annotationLibrary>none</annotationLibrary>
                                <dateLibrary>java8</dateLibrary>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                                <openApiNullable>false</openApiNullable>
                                <useJakartaEe>true</useJakartaEe>
                                <useRuntimeException>true</useRuntimeException>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Contract-Repository>${jobseekercopilot.contract.repository}</Contract-Repository>
                            <Contract-Revision>${jobseekercopilot.contract.revision}</Contract-Revision>
                            <Contract-SHA256>${jobseekercopilot.contract.sha256}</Contract-SHA256>
                            <Contract-Version>${jobseekercopilot.contract.version}</Contract-Version>
                            <Generator-Version>${openapi-generator.version}</Generator-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/jobseekercopilot/cv-cover-letter-service</url>
        </repository>
    </distributionManagement>
</project>
