<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>com.jobseekercopilot</groupId>
    <artifactId>cv-cover-letter-service</artifactId>
    <version>1.0.0</version>
    <name>CV Cover Letter Service</name>
    <description>Builds CV and cover letter prompts and delegates generation to llm-gateway</description>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.32</lombok.version>
        <springdoc.version>2.3.0</springdoc.version>
        <openapi-generator.version>7.5.0</openapi-generator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.10</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-llm-gateway-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/llm-gateway.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/llm-gateway</output>
                            <apiPackage>com.jobseekercopilot.generated.llmgateway.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.llmgateway.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.llmgateway.client</invokerPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-document-store-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/document-store-service.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/document-store-service</output>
                            <apiPackage>com.jobseekercopilot.generated.documentstoreservice.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.documentstoreservice.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.documentstoreservice.client</invokerPackage>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-application-tracker-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/application-tracker-service.json</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi/application-tracker-service</output>
                            <apiPackage>com.jobseekercopilot.generated.applicationtrackerservice.api</apiPackage>
                            <modelPackage>com.jobseekercopilot.generated.applicationtrackerservice.model</modelPackage>
                            <invokerPackage>com.jobseekercopilot.generated.applicationtrackerservice.client</invokerPackage>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <generatorName>java</generatorName>
                    <library>resttemplate</library>
                    <generateApiTests>false</generateApiTests>
                    <generateModelTests>false</generateModelTests>
                    <generateApiDocumentation>false</generateApiDocumentation>
                    <generateModelDocumentation>false</generateModelDocumentation>
                    <skipValidateSpec>false</skipValidateSpec>
                    <configOptions>
                        <annotationLibrary>none</annotationLibrary>
                        <dateLibrary>java8</dateLibrary>
                        <hideGenerationTimestamp>true</hideGenerationTimestamp>
                        <openApiNullable>false</openApiNullable>
                        <useJakartaEe>true</useJakartaEe>
                        <useRuntimeException>true</useRuntimeException>
                    </configOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
