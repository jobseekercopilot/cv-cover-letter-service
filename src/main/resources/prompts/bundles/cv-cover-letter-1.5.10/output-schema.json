{
  "type": "object",
  "properties": {
    "cv": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "pattern": "^[\\s\\S]{1,200}$"},
        "targetRole": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
        "personalSummary": {"type": "string", "pattern": "^[\\s\\S]{1,2000}$"},
        "coreSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "pattern": "^[\\s\\S]{1,100}$"},
              "evidence": {"type": "string", "pattern": "^[\\s\\S]{0}$", "enum": [""]}
            },
            "required": ["name", "evidence"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 12
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
              "role": {"type": "string", "pattern": "^[\\s\\S]{0,160}$"},
              "context": {"type": "string", "pattern": "^[\\s\\S]{0,160}$"},
              "startDate": {"type": "string", "pattern": "^[\\s\\S]{0,20}$"},
              "endDate": {"type": "string", "pattern": "^[\\s\\S]{0,20}$"},
              "description": {"type": "string", "pattern": "^[\\s\\S]{1,2000}$"},
              "highlights": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {"type": "string", "pattern": "^[\\s\\S]{1,1000}$"},
                    "disposition": {"type": "string", "pattern": "^(SUPPORTED|REWORDED)$", "enum": ["SUPPORTED", "REWORDED"]},
                    "evidenceIds": {
                      "type": "array",
                      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,160}$"},
                      "minItems": 1,
                      "maxItems": 30
                    }
                  },
                  "required": ["text", "disposition", "evidenceIds"],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 8
              }
            },
            "required": ["title", "role", "context", "startDate", "endDate", "description", "highlights"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 10
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualificationName": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
              "issuingBody": {"type": "string", "pattern": "^[\\s\\S]{0,160}$"},
              "status": {"type": "string", "pattern": "^[\\s\\S]{0,80}$"},
              "grade": {"type": "string", "pattern": "^[\\s\\S]{0,80}$"},
              "dateAchieved": {"type": "string", "pattern": "^[\\s\\S]{0,20}$"},
              "expectedCompletion": {"type": "string", "pattern": "^[\\s\\S]{0,20}$"}
            },
            "required": ["qualificationName", "issuingBody", "status", "grade", "dateAchieved", "expectedCompletion"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 20
        },
        "workHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobTitle": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
              "employer": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
              "startDate": {"type": "string", "pattern": "^[\\s\\S]{1,20}$"},
              "endDate": {"type": "string", "pattern": "^[\\s\\S]{0,20}$"},
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {"type": "string", "pattern": "^[\\s\\S]{1,1000}$"},
                    "disposition": {"type": "string", "pattern": "^(SUPPORTED|REWORDED)$", "enum": ["SUPPORTED", "REWORDED"]},
                    "evidenceIds": {
                      "type": "array",
                      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,160}$"},
                      "minItems": 1,
                      "maxItems": 30
                    }
                  },
                  "required": ["text", "disposition", "evidenceIds"],
                  "additionalProperties": false
                },
                "minItems": 0,
                "maxItems": 12
              },
              "tailoredDescription": {"type": "string", "pattern": "^[\\s\\S]{0,2000}$"}
            },
            "required": ["jobTitle", "employer", "startDate", "endDate", "responsibilities", "tailoredDescription"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": ["title", "targetRole", "personalSummary", "coreSkills", "projects", "qualifications", "workHistory"],
      "additionalProperties": false
    },
    "coverLetter": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "pattern": "^[\\s\\S]{1,200}$"},
        "jobTitle": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
        "companyName": {"type": "string", "pattern": "^[\\s\\S]{1,160}$"},
        "greeting": {"type": "string", "pattern": "^Dear Hiring Manager$"},
        "openingParagraph": {
          "type": "string",
          "pattern": "^Please consider my application for this role\\.$",
          "enum": ["Please consider my application for this role."]
        },
        "bodyParagraphs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {"type": "string", "pattern": "^[\\s\\S]{1,3000}$"},
              "disposition": {"type": "string", "pattern": "^(SUPPORTED|REWORDED)$", "enum": ["SUPPORTED", "REWORDED"]},
              "evidenceIds": {
                "type": "array",
                "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,160}$"},
                "minItems": 1,
                "maxItems": 30
              }
            },
            "required": ["text", "disposition", "evidenceIds"],
            "additionalProperties": false
          },
          "minItems": 3,
          "maxItems": 5
        },
        "closingParagraph": {
          "type": "string",
          "pattern": "^Thank you for considering my application\\.$",
          "enum": ["Thank you for considering my application."]
        },
        "signOff": {"type": "string", "pattern": "^Yours faithfully$"}
      },
      "required": ["title", "jobTitle", "companyName", "greeting", "openingParagraph", "bodyParagraphs", "closingParagraph", "signOff"],
      "additionalProperties": false
    },
    "generationNotes": {
      "type": "object",
      "properties": {
        "assumptionsMade": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[\\s\\S]{1,500}$"},
          "minItems": 0,
          "maxItems": 20
        },
        "missingInformation": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[\\s\\S]{1,500}$"},
          "minItems": 0,
          "maxItems": 20
        },
        "tailoringSummary": {"type": "string", "pattern": "^[\\s\\S]{1,2000}$"}
      },
      "required": ["assumptionsMade", "missingInformation", "tailoringSummary"],
      "additionalProperties": false
    },
    "canonicalApplicationClaims": {
      "type": "object",
      "properties": {
        "opening": {
          "type": "object",
          "properties": {
            "claimId": {"type": "string", "pattern": "^CLAIM-9001$", "enum": ["CLAIM-9001"]},
            "disposition": {"type": "string", "pattern": "^SUPPORTED$", "enum": ["SUPPORTED"]},
            "generationIntentEvidenceId": {"type": "string", "pattern": "^REQUEST\\.GENERATION_INTENT$", "enum": ["REQUEST.GENERATION_INTENT"]},
            "jobTitleEvidenceId": {"type": "string", "pattern": "^JOB\\.TITLE$", "enum": ["JOB.TITLE"]},
            "companyEvidenceId": {"type": "string", "pattern": "^JOB\\.COMPANY$", "enum": ["JOB.COMPANY"]},
            "contentPath": {"type": "string", "pattern": "^/coverLetter/openingParagraph$", "enum": ["/coverLetter/openingParagraph"]},
            "reviewText": {"type": "string", "pattern": "^[\\s\\S]{0}$", "enum": [""]}
          },
          "required": ["claimId", "disposition", "generationIntentEvidenceId", "jobTitleEvidenceId", "companyEvidenceId", "contentPath", "reviewText"],
          "additionalProperties": false
        },
        "closing": {
          "type": "object",
          "properties": {
            "claimId": {"type": "string", "pattern": "^CLAIM-9002$", "enum": ["CLAIM-9002"]},
            "disposition": {"type": "string", "pattern": "^SUPPORTED$", "enum": ["SUPPORTED"]},
            "generationIntentEvidenceId": {"type": "string", "pattern": "^REQUEST\\.GENERATION_INTENT$", "enum": ["REQUEST.GENERATION_INTENT"]},
            "jobTitleEvidenceId": {"type": "string", "pattern": "^JOB\\.TITLE$", "enum": ["JOB.TITLE"]},
            "companyEvidenceId": {"type": "string", "pattern": "^JOB\\.COMPANY$", "enum": ["JOB.COMPANY"]},
            "contentPath": {"type": "string", "pattern": "^/coverLetter/closingParagraph$", "enum": ["/coverLetter/closingParagraph"]},
            "reviewText": {"type": "string", "pattern": "^[\\s\\S]{0}$", "enum": [""]}
          },
          "required": ["claimId", "disposition", "generationIntentEvidenceId", "jobTitleEvidenceId", "companyEvidenceId", "contentPath", "reviewText"],
          "additionalProperties": false
        }
      },
      "required": ["opening", "closing"],
      "additionalProperties": false
    },
    "personalSummaryClaim": {
      "type": "object",
      "properties": {
        "claimId": {"type": "string", "pattern": "^CLAIM-9003$", "enum": ["CLAIM-9003"]},
        "disposition": {"type": "string", "pattern": "^(SUPPORTED|REWORDED)$", "enum": ["SUPPORTED", "REWORDED"]},
        "evidenceIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,160}$"},
          "minItems": 1,
          "maxItems": 30
        },
        "contentPath": {"type": "string", "pattern": "^/cv/personalSummary$", "enum": ["/cv/personalSummary"]},
        "reviewText": {"type": "string", "pattern": "^[\\s\\S]{0}$", "enum": [""]}
      },
      "required": ["claimId", "disposition", "evidenceIds", "contentPath", "reviewText"],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claimId": {"type": "string", "pattern": "^CLAIM-[0-8][0-9]{2,3}$"},
          "disposition": {"type": "string", "pattern": "^(SUPPORTED|REWORDED)$", "enum": ["SUPPORTED", "REWORDED"]},
          "evidenceIds": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,160}$"},
            "minItems": 1,
            "maxItems": 30
          },
          "contentPaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:/cv/targetRole|/cv/projects/[0-9]+/(?:title|role|context|startDate|endDate|description)|/cv/qualifications/[0-9]+/(?:qualificationName|issuingBody|status|grade|dateAchieved|expectedCompletion)|/cv/workHistory/[0-9]+/(?:jobTitle|employer|startDate|endDate|tailoredDescription)|/coverLetter/(?:jobTitle|companyName))$"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "reviewText": {"type": "string", "pattern": "^[\\s\\S]{0}$", "enum": [""]}
        },
        "required": ["claimId", "disposition", "evidenceIds", "contentPaths", "reviewText"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20
    }
  },
  "required": ["cv", "coverLetter", "generationNotes", "canonicalApplicationClaims", "personalSummaryClaim", "claims"],
  "additionalProperties": false
}
