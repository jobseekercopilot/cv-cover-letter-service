{
  "type": "object",
  "properties": {
    "cv": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        },
        "targetRole": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,160}$"
        },
        "personalSummary": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        },
        "coreSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,100}$"
              },
              "evidence": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,1000}$"
              }
            },
            "required": [
              "name",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 40
        },
        "qualifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualificationName": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,160}$"
              },
              "issuingBody": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,160}$"
              },
              "status": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,80}$"
              },
              "grade": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,80}$"
              },
              "dateAchieved": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,20}$"
              },
              "expectedCompletion": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,20}$"
              }
            },
            "required": [
              "qualificationName",
              "issuingBody",
              "status",
              "grade",
              "dateAchieved",
              "expectedCompletion"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 30
        },
        "workHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobTitle": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,160}$"
              },
              "employer": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,160}$"
              },
              "startDate": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,20}$"
              },
              "endDate": {
                "type": "string",
                "pattern": "^[\\s\\S]{0,20}$"
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[\\s\\S]{1,1000}$"
                },
                "minItems": 0,
                "maxItems": 20
              },
              "tailoredDescription": {
                "type": "string",
                "pattern": "^[\\s\\S]{1,2000}$"
              }
            },
            "required": [
              "jobTitle",
              "employer",
              "startDate",
              "endDate",
              "responsibilities",
              "tailoredDescription"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 30
        }
      },
      "required": [
        "title",
        "targetRole",
        "personalSummary",
        "coreSkills",
        "qualifications",
        "workHistory"
      ],
      "additionalProperties": false
    },
    "coverLetter": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        },
        "jobTitle": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,160}$"
        },
        "companyName": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,160}$"
        },
        "greeting": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        },
        "openingParagraph": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        },
        "bodyParagraphs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,3000}$"
          },
          "minItems": 1,
          "maxItems": 7
        },
        "closingParagraph": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        },
        "signOff": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,200}$"
        }
      },
      "required": [
        "title",
        "jobTitle",
        "companyName",
        "greeting",
        "openingParagraph",
        "bodyParagraphs",
        "closingParagraph",
        "signOff"
      ],
      "additionalProperties": false
    },
    "generationNotes": {
      "type": "object",
      "properties": {
        "assumptionsMade": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,500}$"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "missingInformation": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[\\s\\S]{1,500}$"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "tailoringSummary": {
          "type": "string",
          "pattern": "^[\\s\\S]{1,2000}$"
        }
      },
      "required": [
        "assumptionsMade",
        "missingInformation",
        "tailoringSummary"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "cv",
    "coverLetter",
    "generationNotes"
  ],
  "additionalProperties": false
}
