{"openapi":"3.0.1","info":{"title":"Jobseeker Copilot - LLM Gateway API","description":"Provider-neutral generation boundary for Job Seeker Copilot.\n\nThis gateway:\n- Separates trusted task instructions from untrusted source data\n- Requires an explicit output contract and bounded limits\n- Hides adapter request structures and credentials\n- Supports fail-closed DISABLED, deterministic FIXTURE and explicit LIVE modes\n\nThe deprecated v1 raw-prompt endpoint remains only for a bounded consumer migration.\n","contact":{"name":"Jobseeker Copilot"},"license":{"name":"MIT"},"version":"2.0.0"},"servers":[{"url":"http://localhost","description":"Generated server url"}],"tags":[{"name":"Model Generation","description":"Provider-neutral bounded generation endpoints"}],"paths":{"/api/v2/generations":{"post":{"tags":["Model Generation"],"summary":"Generate bounded content through the configured adapter","description":"Accepts a domain task, separately delimited trusted instructions and untrusted\ninput, an explicit output contract, and hard generation limits. Provider names,\nrequest structures and credentials are not exposed to the caller.\n","operationId":"generateV2","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerationRequest"}}},"required":true},"responses":{"401":{"description":"Configured adapter authentication failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"504":{"description":"Configured adapter did not respond in time","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Configured adapter returned an invalid response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"503":{"description":"Generation is disabled or the configured adapter is unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"200":{"description":"Content generated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerationResponse"}}}},"500":{"description":"Unexpected internal failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Configured adapter authentication was forbidden","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Configured adapter rate limited the request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Generation was refused or filtered","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"400":{"description":"Malformed request, unsupported fields or validation failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/generate":{"post":{"tags":["Model Generation"],"summary":"Generate content from a deprecated raw prompt","description":"Transitional compatibility endpoint for the current CV consumer. New consumers\nmust use /api/v2/generations. This endpoint will be removed after consumer\nmigration because it cannot express a trusted/untrusted input boundary.\n","operationId":"generate","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateRequest"}}},"required":true},"responses":{"401":{"description":"Provider authentication failure","content":{"*/*":{"schema":{"$ref":"#/components/schemas/GenerateResponse"}}}},"504":{"description":"Generation adapter did not respond in time","content":{"*/*":{"schema":{"$ref":"#/components/schemas/GenerateResponse"}}}},"400":{"description":"Validation error - missing or invalid fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"examples":{"validationError":{"summary":"Validation error","description":"validationError","value":{"status":400,"error":"VALIDATION_FAILED","message":"Request validation failed","timestamp":"2026-06-21T12:00:00","details":["prompt: prompt is required and cannot be empty"]}}}}}},"503":{"description":"Generation adapter disabled or unavailable","content":{"*/*":{"schema":{"$ref":"#/components/schemas/GenerateResponse"}}}},"200":{"description":"Content generated successfully","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateResponse"},"examples":{"successfulGeneration":{"summary":"Successful generation response","description":"successfulGeneration","value":{"provider":"OPENAI","model":"gpt-4.1-mini","usage":{"provider":"OPENAI","model":"gpt-4.1-mini","inputTokens":4200,"outputTokens":3100,"totalTokens":7300},"response":"{\"message\":\"Generated content from OpenAI\"}"}}}}}}},"deprecated":true}}},"components":{"schemas":{"GenerationLimits":{"required":["maxOutputTokens","temperature"],"type":"object","properties":{"maxOutputTokens":{"maximum":32768,"minimum":1,"type":"integer","format":"int32","example":3000},"temperature":{"maximum":1.0,"exclusiveMaximum":false,"minimum":0.0,"exclusiveMinimum":false,"type":"number","format":"double","example":0.3}},"additionalProperties":false,"description":"Explicit provider-neutral generation limits"},"GenerationOutputContract":{"required":["format"],"type":"object","properties":{"format":{"type":"string","enum":["TEXT","JSON_SCHEMA"]},"schemaId":{"maxLength":64,"minLength":0,"pattern":"[a-z][a-z0-9_-]{0,63}","type":"string","example":"cv-cover-letter-output"},"schemaVersion":{"maxLength":32,"minLength":0,"pattern":"[0-9]+\\.[0-9]+(?:\\.[0-9]+)?","type":"string","example":"1.0"},"jsonSchema":{"$ref":"#/components/schemas/JsonNode"}},"additionalProperties":false,"description":"Requested output format and optional strict JSON Schema"},"GenerationRequest":{"required":["contractVersion","limits","output","task","trustedInstructions","untrustedInput"],"type":"object","properties":{"contractVersion":{"pattern":"2\\.0","type":"string","example":"2.0","enum":["2.0"]},